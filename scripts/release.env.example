## Copy this file to scripts/release.env and customize values as needed.
## This file is sourced by scripts/release_dmg.sh if present.

# Fixed values for this repo
SCHEME=Dayflow
CONFIG=Release
APP_NAME=Dayflow

# Your Developer ID Application certificate common name
# List yours with: security find-identity -v -p codesigning | grep "Developer ID Application"
SIGN_ID='Developer ID Application: Teleport Labs, Inc. (L75WYD8X4Y)'

# Notarytool keychain profile set via:
# xcrun notarytool store-credentials AC_NOTARY --apple-id "you@domain.com" --team-id L75WYD8X4Y --password "app-specific-password"
NOTARY_PROFILE=AC_NOTARY

# Backend URL injected at release time. Requests to it are refused unless it is on this Mac.
DAYFLOW_BACKEND_URL=
