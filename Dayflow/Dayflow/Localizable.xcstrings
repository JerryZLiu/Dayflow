    "%@ had the most interruptions, with %lld context shifts and %lld distractions." : {
      "comment" : "Weekly context chart footer. %@ is an abbreviated weekday label (e.g. \"Tue\"); then the context-shift count, then the distraction count.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Am %@ gab es mit %lld Kontextwechseln und %lld Ablenkungen die meisten Unterbrechungen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
