    " LLM, but we strongly recommend using Qwen3-VL 4B based on our internal benchmarks." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " LLM, aber aufgrund unserer internen Benchmarks empfehlen wir dringend Qwen3-VL 4B."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " LLM, mais d’après nos tests internes, nous recommandons vivement Qwen3-VL 4B."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " LLMですが、社内ベンチマークに基づき、Qwen3-VL 4Bの使用を強くおすすめします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " LLM이지만, 내부 벤치마크 결과에 따라 Qwen3-VL 4B 사용을 강력히 권장합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " LLM, но по результатам наших внутренних тестов мы настоятельно рекомендуем Qwen3-VL 4B."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " LLM，但根据我们的内部基准测试，强烈建议使用 Qwen3-VL 4B。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : " LLM，但根據我們的內部基準測試，強烈建議使用 Qwen3-VL 4B。"
          }
        }
      }
    },
