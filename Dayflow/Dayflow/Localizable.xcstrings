    "Local AI analyzes your activities to create a timeline of your day without sending data to the cloud." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lokale KI analysiert deine Aktivitäten und erstellt eine Zeitleiste deines Tages, ohne Daten an die Cloud zu senden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’IA locale analyse vos activités pour créer la chronologie de votre journée sans envoyer de données dans le cloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ローカル AI がデータをクラウドに送信せずにアクティビティを分析し、1 日のタイムラインを作成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "로컬 AI가 데이터를 클라우드로 전송하지 않고 활동을 분석해 하루의 타임라인을 만듭니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Локальный ИИ анализирует ваши действия и создаёт хронику дня, не отправляя данные в облако."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "本地 AI 会分析你的活动并创建当天的时间线，无需将数据发送到云端。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "本機 AI 會分析你的活動並建立當天的時間軸，無需將資料傳送到雲端。"
          }
        }
      }
    },
