          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "언제든지 카테고리를 맞춤 설정하거나 새로 만들 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
