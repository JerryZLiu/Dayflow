    "You are always in control — you can pause or turn off Dayflow whenever you like." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du behältst immer die Kontrolle – du kannst Dayflow jederzeit pausieren oder ausschalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vous gardez toujours le contrôle : vous pouvez mettre Dayflow en pause ou le désactiver à tout moment."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "操作は常にあなた次第です。Dayflowはいつでも一時停止またはオフにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "항상 직접 제어할 수 있습니다. 언제든지 Dayflow를 일시 정지하거나 끌 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вы всегда контролируете процесс — Dayflow можно приостановить или отключить в любой момент."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "控制权始终在你手中——你可以随时暂停或关闭 Dayflow。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "控制權始終在你手中——你可以隨時暫停或關閉 Dayflow。"
          }
        }
      }
    },
    "You are ready to go!" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alles ist startklar!"
