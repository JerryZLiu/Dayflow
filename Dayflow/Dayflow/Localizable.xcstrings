      }
    },
    "You can customize or create new categories any time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du kannst Kategorien jederzeit anpassen oder neu erstellen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vous pouvez personnaliser ou créer des catégories à tout moment."
