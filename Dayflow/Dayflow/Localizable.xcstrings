    "Edge case: lots of small low-weight peripherals around one dominant app." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Grenzfall: viele kleine, schwach gewichtete Randbereiche um eine dominante App."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cas limite : beaucoup de petits éléments périphériques de faible poids autour d’une application dominante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "エッジケース：1つの主要アプリの周囲に、重みの小さい項目が多数ある。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "예외 상황: 하나의 주요 앱 주변에 가중치가 낮은 작은 주변 항목이 많음."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Крайний случай: множество мелких элементов с низким весом вокруг одного доминирующего приложения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "边缘情况：一个主导应用周围有许多权重较低的小型外围项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "邊緣情況：一個主導 App 周圍有許多權重較低的小型周邊項目。"
          }
        }
      }
    },
