            "value" : "알림을 보내드립니다"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Мы вас уведомим"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
