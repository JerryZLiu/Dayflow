        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@에 방해가 가장 많았으며, 컨텍스트 전환 %lld회, 주의 분산 %lld회를 기록했습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Больше всего прерываний было в %@: переключений контекста — %lld, отвлечений — %lld."
