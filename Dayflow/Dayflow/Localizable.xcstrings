    "Chat lets you ask questions about your Dayflow activity and get summaries, comparisons, and insights." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Im Chat kannst du Fragen zu deinen Dayflow-Aktivitäten stellen und Zusammenfassungen, Vergleiche und Einblicke erhalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le chat vous permet de poser des questions sur votre activité Dayflow et d’obtenir des résumés, des comparaisons et des analyses."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "チャットでは、Dayflowのアクティビティについて質問し、要約、比較、分析を得られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "채팅에서 Dayflow 활동에 관해 질문하고 요약, 비교 및 인사이트를 얻을 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "В чате можно задавать вопросы о вашей активности в Dayflow и получать сводки, сравнения и полезные выводы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你可以在聊天中询问有关 Dayflow 活动的问题，并获取摘要、比较和洞察。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你可以在聊天中詢問有關 Dayflow 活動的問題，並取得摘要、比較和深入解析。"
          }
        }
      }
    },
    "Chat unlocks after Dayflow has analyzed enough activity. %@" : {
