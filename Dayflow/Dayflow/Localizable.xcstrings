    "Claude activity card %lld contains both '%@' and '%@'. Return exactly one timestamp field." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Claude-Aktivitätskarte %1$lld enthält sowohl '%2$@' als auch '%3$@'. Gib genau ein Zeitstempelfeld zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Claude activity card %1$lld contains both '%2$@' and '%3$@'. Return exactly one timestamp field."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La carte d’activité Claude %1$lld contient à la fois '%2$@' et '%3$@'. Renvoyez exactement un champ d’horodatage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Claudeアクティビティカード%1$lldに'%2$@'と'%3$@'の両方が含まれています。タイムスタンプフィールドを1つだけ返してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Claude 활동 카드 %1$lld에 '%2$@' 및 '%3$@'이(가) 모두 포함되어 있습니다. 타임스탬프 필드를 정확히 하나만 반환하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Карточка активности Claude %1$lld содержит и '%2$@', и '%3$@'. Верните ровно одно поле временной метки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Claude 活动卡片 %1$lld 同时包含 '%2$@' 和 '%3$@'。请仅返回一个时间戳字段。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Claude 活動卡片 %1$lld 同時包含 '%2$@' 和 '%3$@'。請只傳回一個時間戳記欄位。"
          }
        }
      }
    },
