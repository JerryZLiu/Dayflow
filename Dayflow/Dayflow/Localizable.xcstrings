    "We want you to be able to try Dayflow for free, no credit card and no strings attached!" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wir möchten, dass du Dayflow kostenlos testen kannst – ohne Kreditkarte und ohne Verpflichtungen!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nous voulons que vous puissiez essayer Dayflow gratuitement, sans carte bancaire et sans aucun engagement !"
