        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "신용카드나 조건 없이 Dayflow를 무료로 체험해 보세요!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
