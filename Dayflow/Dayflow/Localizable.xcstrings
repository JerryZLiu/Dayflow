    },
    "We'll ask your CLI a simple question to verify it's working and signed in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wir stellen deiner CLI eine einfache Frage, um zu prüfen, ob sie funktioniert und angemeldet ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nous poserons une question simple à votre CLI pour vérifier qu’il fonctionne et que vous êtes connecté."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "CLIに簡単な質問をして、正常に動作し、サインイン済みであることを確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "CLI에 간단한 질문을 보내 정상 작동 중이며 로그인되어 있는지 확인합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Мы зададим вашему CLI простой вопрос, чтобы проверить, работает ли он и выполнен ли вход."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "我们会通过你的 CLI 提一个简单问题，以确认它运行正常且已登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
