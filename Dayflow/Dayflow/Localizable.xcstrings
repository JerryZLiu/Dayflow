    "AI output follows the app language by default. Enter a language to override it, or reset to follow the app language. Existing summaries stay unchanged." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "KI-Ausgaben verwenden standardmäßig die App-Sprache. Gib eine andere Sprache ein oder setze die Einstellung auf die App-Sprache zurück. Bestehende Zusammenfassungen bleiben unverändert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Par défaut, les résultats de l’IA utilisent la langue de l’app. Saisissez une autre langue ou réinitialisez pour suivre celle de l’app. Les résumés existants restent inchangés."
          }
        },
        "ja" : {
          "stringUnit" : {
