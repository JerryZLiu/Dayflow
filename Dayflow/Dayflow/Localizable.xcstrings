    "You earn **1 month of Dayflow Pro (stackable!)**, when they use Dayflow for a week." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du erhältst **1 Monat Dayflow Pro (stapelbar!)**, sobald die Person Dayflow eine Woche lang verwendet hat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vous gagnez **1 mois de Dayflow Pro (cumulable !)** lorsque la personne utilise Dayflow pendant une semaine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "相手が Dayflow を1週間使用すると、**Dayflow Pro 1か月分（積み上げ可能！）**を獲得できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "상대방이 Dayflow를 일주일 동안 사용하면 **Dayflow Pro 1개월(중복 적립 가능!)**을 받습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вы получите **1 месяц Dayflow Pro (можно суммировать!)**, когда приглашённый пользователь будет пользоваться Dayflow в течение недели."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "当对方使用 Dayflow 满一周后，你将获得 **1 个月 Dayflow Pro（可叠加！）**。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "當對方使用 Dayflow 滿一週後，你將獲得 **1 個月 Dayflow Pro（可累加！）**。"
          }
        }
      }
    },
    "You have a new support reply. Open Support to read it." : {
      "localizations" : {
